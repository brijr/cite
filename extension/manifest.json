{
  "manifest_version": 3,
  "name": "Cite",
  "version": "1.0.0",
  "description": "Click anything on a web page. Tell a coding agent what to change.",
  "minimum_chrome_version": "102",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Cite this page",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "inspect": {
      "suggested_key": {
        "default": "Ctrl+Shift+F",
        "mac": "Command+Shift+F"
      },
      "description": "Inspect this page with Cite"
    }
  },
  "permissions": ["activeTab", "scripting"]
}
